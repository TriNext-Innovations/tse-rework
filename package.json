{
  "name": "tse-online",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean",
    "migration:generate-skus": "tsx scripts/generate-skus.ts"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.6",
      "@medusajs/admin-sdk": "2.13.6"
    }
  }
}
