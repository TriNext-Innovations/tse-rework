{
  "name": "tse-online",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@medusajs/admin-sdk": "2.17.2",
      "@medusajs/admin-shared": "2.17.2",
      "axios": ">=1.16.1",
      "@aws-sdk/client-dynamodb": ">=3.1049.0",
      "protobufjs": ">=7.6.0",
      "@protobufjs/utf8": ">=1.1.1",
      "fast-xml-builder": ">=1.2.0",
      "fast-xml-parser": ">=5.7.0",
      "brace-expansion": "^2.0.1",
      "postcss": ">=8.5.10",
      "ajv": ">=8.18.0",
      "lodash": ">=4.18.0",
      "@mikro-orm/knex": ">=6.6.14",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "i18next-http-backend": ">=3.0.5"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
