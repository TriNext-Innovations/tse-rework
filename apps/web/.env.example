# ─── Medusa Backend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tse-cartridges.co.za

# ─── Meilisearch ──────────────────────────────────────────────────────────────
# Search-only keys ONLY. Never put the Meili admin/master key (MEILISEARCH_API_KEY)
# in the storefront — that belongs solely to the backend (indexer / bulk-index).
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
# Optional server-only search key for the products page (falls back to the public
# key above). Still a search-only key — not the admin key.
MEILISEARCH_HOST=
MEILISEARCH_SEARCH_KEY=

# ─── PayFast ──────────────────────────────────────────────────────────────────
# Get from https://www.payfast.co.za/eng/merchant/details
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Set 'true' to drive checkout through the Medusa PayFast provider (canonical
# flow, #130). Leave 'false'/unset to keep the legacy /api/payfast/initiate path.
# Turn on only in a sandbox env until verified — see docs/payfast-sandbox.md.
NEXT_PUBLIC_PAYFAST_PROVIDER=false

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Create a project at https://sentry.io → Settings → Projects
# DSN: Project Settings → Client Keys → DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Required only for source-map uploads during CI build:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
