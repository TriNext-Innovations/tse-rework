# URL of the running Medusa backend (no trailing slash)
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000

# Medusa publishable API key (create in Medusa admin → Settings → API keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tse-cartridges.co.za
