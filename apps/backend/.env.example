# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/tse_medusa

# ─── Cache ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Medusa Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=

# ─── Admin ────────────────────────────────────────────────────────────────────
# Initial admin user (used on first boot only)
MEDUSA_ADMIN_EMAIL=admin@tse.co.za
MEDUSA_ADMIN_PASSWORD=

# ─── PayFast ──────────────────────────────────────────────────────────────────
# Merchant credentials from PayFast dashboard (https://www.payfast.co.za)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set to 'true' in production, 'false' for sandbox testing
PAYFAST_LIVE=false

# Optional: pin the region / sales channel used when a PayFast payment is turned
# into an order. Leave blank to resolve automatically (ZAR region + the store's
# default sales channel). If set, they must reference ids that exist in THIS
# environment — order creation fails loudly rather than using a wrong/stale id.
MEDUSA_ZAR_REGION_ID=
MEDUSA_SALES_CHANNEL_ID=

# ─── Ozow ─────────────────────────────────────────────────────────────────────
# Instant EFT credentials from Ozow dashboard
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=

# ─── Resend (transactional email) ─────────────────────────────────────────────
# API key from resend.com dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tse.co.za

# ─── Storefront ───────────────────────────────────────────────────────────────
# Used for CORS and webhook return URLs
STOREFRONT_URL=https://tse-cartridges.co.za

# ─── Shipping — The Courier Guy (ShipLogic) ───────────────────────────────────
# Bearer token from the ShipLogic / Courier Guy portal.
TCG_API_KEY=
# Optional API base override (defaults to https://api.shiplogic.com).
TCG_API_URL=

# Collection (warehouse) address that goods ship FROM. Required for live rates.
TCG_COLLECTION_STREET=
TCG_COLLECTION_LOCAL_AREA=Kya Sands
TCG_COLLECTION_CITY=Johannesburg
TCG_COLLECTION_ZONE=Gauteng
TCG_COLLECTION_COUNTRY=ZA
TCG_COLLECTION_CODE=
TCG_COLLECTION_COMPANY=TSE Cartridges
TCG_COLLECTION_CONTACT_NAME=
TCG_COLLECTION_CONTACT_PHONE=
TCG_COLLECTION_CONTACT_EMAIL=

# Fallback parcel used when a variant has no weight/dimensions (cartridge-sized).
TCG_DEFAULT_LENGTH_CM=22
TCG_DEFAULT_WIDTH_CM=11
TCG_DEFAULT_HEIGHT_CM=6
TCG_DEFAULT_WEIGHT_KG=0.5

# Set to "false" if ShipLogic rates are returned EXCLUDING VAT (Medusa then adds tax).
TCG_RATE_TAX_INCLUSIVE=true
# Public tracking URL; {ref} is replaced with the tracking reference.
TCG_TRACKING_URL_TEMPLATE=https://www.thecourierguy.co.za/track?ref={ref}
