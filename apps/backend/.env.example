# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/tse_medusa

# ─── Cache ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Medusa Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=

# ─── Admin ────────────────────────────────────────────────────────────────────
# Initial admin user (used on first boot only)
MEDUSA_ADMIN_EMAIL=admin@tse.co.za
MEDUSA_ADMIN_PASSWORD=

# ─── PayFast ──────────────────────────────────────────────────────────────────
# Merchant credentials from PayFast dashboard (https://www.payfast.co.za)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set to 'true' in production, 'false' for sandbox testing
PAYFAST_LIVE=false

# ─── Ozow ─────────────────────────────────────────────────────────────────────
# Instant EFT credentials from Ozow dashboard
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=

# ─── Resend (transactional email) ─────────────────────────────────────────────
# API key from resend.com dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tse.co.za

# ─── Storefront ───────────────────────────────────────────────────────────────
# Used for CORS and webhook return URLs
STOREFRONT_URL=https://tse-cartridges.co.za

# ─── Shipping — The Courier Guy (ShipLogic) ───────────────────────────────────
# API key from portal.thecourierguy.co.za → Account → API Keys
TCG_API_KEY=

# TSE warehouse / collection address
TCG_ORIGIN_STREET=Kya Sands
TCG_ORIGIN_SUBURB=Kya Sands
TCG_ORIGIN_CITY=Johannesburg
TCG_ORIGIN_PROVINCE=GP
TCG_ORIGIN_POSTAL_CODE=2163

# Dispatch contact shown on waybills
TCG_CONTACT_NAME=TSE Dispatch
TCG_CONTACT_PHONE=0115551234
TCG_CONTACT_EMAIL=dispatch@tse.co.za
