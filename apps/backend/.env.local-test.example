# Local order-flow test (#528). Copied to apps/backend/.env by scripts/local-up.sh
# when no .env exists and ~/.config/tse-local/backend.env is absent.
# Seed data only: no prod database, nothing goes to TSE or customers.

DATABASE_URL=postgresql://postgres:localtest@localhost:5432/tse_medusa
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-only-secret
COOKIE_SECRET=local-only-secret
STORE_CORS=http://localhost:3000
# local-up.sh appends the tunnel URL to these two and sets MEDUSA_BACKEND_URL
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:3000
STOREFRONT_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local-meili-master-key-0123456789

# PayFast sandbox: TriNext's sandbox account (Zoho Vault). The old public
# merchant 10000100 rejects every signature.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Every email goes here and nowhere else. local-up.sh refuses to run without it.
EMAIL_REDIRECT_TO=info@trinextinnovations.co.za
SALES_EMAIL=info@trinextinnovations.co.za
SALES_CC=
EMAIL_FROM=sales@tse-cartridges.co.za
# Real token = real delivery to EMAIL_REDIRECT_TO. Blank = local-up.sh uses the
# mail sink and writes each email to .local-mail/.
ZEPTOMAIL_TOKEN=

# Left blank or fake on purpose: nothing real gets booked or charged
TCG_FAKE=true
TCG_API_KEY=
OZOW_SITE_CODE=
WC_CONSUMER_KEY=
