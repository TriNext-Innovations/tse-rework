    {
      "id": "92501307-5823-5145-9e75-2e29b03371a4",
      "name": "Weekly report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tse-agency:8080/v1/report/weekly",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AGENCY_CREDENTIAL_ID",
          "name": "TSE Agency API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "6b1a94fd-7b61-5248-b1b7-276bd593f750",
      "name": "Report created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3c5384a-3f7a-5e2a-b181-4d56119d973d",
              "leftValue": "={{ $json.result.created === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e0f68530-7113-5984-bc1e-0d0afd38a904",
      "name": "Post weekly report",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        720,
        160
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "={{ '📊 **TSE ads — week of ' + $json.result.week_start + '**\\n' + $json.result.summary.headline_summary + '\\n\\n**Next week:** ' + $json.result.summary.next_week_guidance }}",
        "options": {}
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "hK9mTseDiscordW1",
          "name": "TSE Social Discord Webhook"
        }
      }
    }
