        "method": "POST",
        "url": "http://tse-agency:8080/v1/metrics/collect",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AGENCY_CREDENTIAL_ID",
          "name": "TSE Agency API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "5b0a71e6-ceac-57f2-8cfb-fdd501663401",
      "name": "Monday 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
