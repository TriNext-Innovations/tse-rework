    {
      "id": "aa04f474-7aa9-534c-911f-beafe3e39e27",
      "name": "New campaigns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const planned = ($json.result && $json.result.planned) || [];\nreturn planned.filter(p => p.created).map(p => ({ json: p }));"
      }
    },
    {
      "id": "db8faae1-832e-5f8f-9c70-4919c8c19f06",
