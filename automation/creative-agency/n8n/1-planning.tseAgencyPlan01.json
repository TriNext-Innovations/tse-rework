      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "={{ '🗓️ **New TSE campaign planned** — week of ' + $json.week_start + '\\n**' + $json.name + '**\\n' + $json.proposition + '\\n' + $json.assignments + ' assignments queued.' }}",
        "options": {}
      },
      "credentials": {
        "discordWebhookApi": {
