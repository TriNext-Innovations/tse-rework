{
  "id": "tseAgencyMon01",
  "name": "TSE Agency — 7 Monitoring",
  "description": "Stage: monitoring. Hourly: release expired leases, flag interrupted publications, and send only urgent alerts (live publishing failures, auto-pause, re-approval needed) — silent in dry run. Daily 07:00: one digest with queue, spend, the day's results and every other alert, grouped.",
  "active": false,
  "nodes": [
    {
      "id": "fd4d0302-2a59-5e83-90e2-df9851ee6dce",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        120
      ],
      "parameters": {}
    },
    {
      "id": "9cfd459f-82c4-5803-9003-d6b305896ff4",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "26a3fa6f-155c-53a5-b798-25ea4dd58ee5",
      "name": "Recover",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tse-agency:8080/v1/recover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AGENCY_CREDENTIAL_ID",
          "name": "TSE Agency API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "f6c59bde-42b8-5411-b9c3-229a4e9551ae",
      "name": "Claim urgent alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tse-agency:8080/v1/alerts/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"urgent_only\": true}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AGENCY_CREDENTIAL_ID",
          "name": "TSE Agency API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c6d9d4c6-89b5-5d94-aa9a-928aab3eaa1a",
      "name": "One item per alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "return (($json.result && $json.result.alerts) || []).map(a => ({ json: a }));"
      }
    },
    {
      "id": "d82fe588-a7b4-57cb-8fdc-34a1895a0fe2",
      "name": "Send urgent alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "={{ '🚨 **TSE agency** ' + $json.message }}",
        "options": {}
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "hK9mTseDiscordW1",
          "name": "TSE Social Discord Webhook"
        }
      }
    },
    {
      "id": "ae5979f1-2bbd-5f35-9b61-4ad41a242cc9",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "690ce3a3-bacb-5e16-8c8b-31d8f98c48e0",
      "name": "Build digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://tse-agency:8080/v1/digest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"dashboard_url\": \"https://n8n.tse-cartridges.co.za/agency/review\"}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AGENCY_CREDENTIAL_ID",
          "name": "TSE Agency API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "634e504d-bc21-5514-b1a9-16986197c24a",
      "name": "Daily digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        480,
        220
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.result.text }}",
        "options": {}
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "hK9mTseDiscordW1",
          "name": "TSE Social Discord Webhook"
        }
      }
    }
  ],
