# TSE creative agency — copy to .env (chmod 600). Never commit .env.

# --- service -------------------------------------------------------------------
# Bearer token n8n sends (create the n8n credential "TSE Agency API" as Header Auth:
# name "Authorization", value "Bearer <this token>"). 24+ chars: openssl rand -hex 32
AGENCY_API_TOKEN=
# Password for the /review page (user "review").
AGENCY_REVIEW_PASSWORD=
POSTGRES_PASSWORD=

# Where final JPEGs are publicly reachable. Meta fetches images from here.
MEDIA_PUBLIC_BASE_URL=https://n8n.tse-cartridges.co.za/agency/media
SITE_URL=https://www.tse.co.za

# --- Claude ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Per-stage model overrides (default for all: claude-opus-5-5)
# AGENCY_MODEL=claude-opus-5-5
# MODEL_COPYWRITER=claude-opus-5-5
# MODEL_QC_VISION=claude-opus-5-5

# --- fal.ai ----------------------------------------------------------------------
FAL_KEY=

# --- Store (product spotlights) -------------------------------------------------------
# The storefront's publishable key (public; it ships in the web bundle). Without it,
# spotlights are skipped and the product pillar stays conceptual.
MEDUSA_STORE_URL=https://api.tse-cartridges.co.za
MEDUSA_PUBLISHABLE_KEY=
# MEDUSA_REGION_ID=   # optional; the ZAR region is looked up automatically

# --- Meta -------------------------------------------------------------------------
# A long-lived Page access token with pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish (and read_insights / instagram_manage_insights
# for metrics). The TSE Facebook Page and its linked Instagram professional account:
META_PAGE_ID=1137443329680008
META_IG_USER_ID=17841465614689227
META_PAGE_TOKEN=
META_GRAPH_VERSION=v25.0

# Hard gate. Nothing reaches Meta's write endpoints unless this is true AND the
# database mode is review/autonomous. Leave false until the review period ends.
LIVE_PUBLISHING_ENABLED=false
