# =============================================
# TSE Online — Local Development Variables
# Copy to .env.local for Next.js, or .env for the Medusa backend
# For staging/docker-compose, see .env.staging.example
# =============================================

# --- Medusa Backend ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tse_medusa
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
# REQUIRED by the storefront — without it every /store call returns
# "Publishable API key required in the request header: x-publishable-api-key"
# and the storefront renders no products, no cart and no search.
# After the backend has been migrated and seeded once, print the key with:
#   pnpm --filter @tse/backend key
# (or copy it from Medusa admin: Settings -> Publishable API keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
JWT_SECRET=localsecret
COOKIE_SECRET=localsecret
REDIS_URL=redis://localhost:6379
# Required in Docker: Redis runs with --requirepass and is referenced by
# docker-compose REDIS_URL as redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=changeme-strong-redis-password
# Shared secret for the server-to-server PayFast pending/capture routes that
# turn a confirmed payment into a Medusa order. Must match in medusa + web.
PAYFAST_CAPTURE_SECRET=changeme-strong-capture-secret
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:3000

# --- Storefront ---
STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- TCG Pricing API ---
TCG_API_KEY=

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Cloudflare R2 (S3-compatible, free tier — product image storage) ---
# OPTIONAL LOCALLY. These are the names medusa-config.ts actually reads; the
# old S3_* names here were read by nothing. Leave R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY blank and the S3 file provider is not registered at
# all, so the backend boots without object storage — fine for everything
# except testing uploads. Set all five to use a real bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-url>
R2_BUCKET=tse-product-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- PayFast ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=http://localhost:9000/webhooks/payfast

# --- Ozow ---
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_NOTIFY_URL=http://localhost:9000/webhooks/ozow

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# --- Google Maps (checkout address autocomplete) ---
# Google Maps Platform key with the Places API (New) enabled. Optional: the
# checkout address field falls back to plain manual entry when unset. Restrict
# the key to your domains (HTTP referrers) + the Places API in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Analytics 4 ---
# Measurement ID from the GA4 property (Admin > Data streams), format G-XXXXXXX.
# Unset = no analytics loads at all, which is what non-production should do.
# The tag only fires once a visitor picks "Accept all" on the cookie banner
# (POPIA — see src/lib/consent.ts), and page views are sent manually, so turn
# OFF Enhanced Measurement's "Page changes based on browser history events" in
# the GA4 property or SPA navigations get counted twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console ---
# Only needed for a URL-prefix property. The live property is verified by DNS
# TXT on the Cloudflare zone instead, which covers every subdomain at once.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- ZeptoMail (Transactional Email) ---
# Send-mail token from the ZeptoMail console (with or without the
# "Zoho-enczapikey " prefix). SALES_CC optionally copies extra inboxes
# (comma-separated) on team notifications.
ZEPTOMAIL_TOKEN=
SALES_EMAIL=sales@tse.co.za
SALES_CC=

# --- Anthropic (AI Caption Generation) ---
ANTHROPIC_API_KEY=

# --- Meta Graph API (Instagram / Facebook) ---
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=
META_FACEBOOK_PAGE_ID=

# --- n8n Automation ---
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# --- Courier APIs ---
COURIER_GUY_API_KEY=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=ZA

# --- Error tracking (Bugsink, self-hosted Sentry-compatible) ---
# UI: ssh -L 8100:localhost:8100 <vm> -> http://localhost:8100
BUGSINK_SECRET_KEY=
# First boot only (email:password), then remove:
BUGSINK_SUPERUSER=
# Server-side DSN (internal): http://<key>@bugsink:8000/<project_id>
SENTRY_DSN=
# Browser DSN (public path): https://<key>@api.tse-cartridges.co.za/bugsink/<project_id>
NEXT_PUBLIC_SENTRY_DSN=
