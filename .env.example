# =============================================
# TSE Online — Environment Variables
# Copy to .env.local (frontend) or .env (backend)
# =============================================

# --- Medusa Backend ---
DATABASE_URL=postgresql://user:password@localhost:5432/tse_online
MEDUSA_BACKEND_URL=https://api.tseonline.co.za
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.tseonline.co.za
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PayFast ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=https://api.tseonline.co.za/webhooks/payfast

# --- Ozow ---
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_NOTIFY_URL=https://api.tseonline.co.za/webhooks/ozow

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# --- Resend (Transactional Email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@tseonline.co.za

# --- Anthropic (AI Caption Generation) ---
ANTHROPIC_API_KEY=

# --- Meta Graph API (Instagram / Facebook) ---
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=
META_FACEBOOK_PAGE_ID=

# --- n8n Automation ---
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=https://your-n8n.railway.app/webhook/

# --- Courier APIs ---
COURIER_GUY_API_KEY=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=ZA
