public-hoist-pattern[]=*@medusajs*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=react-dom/client

# Flatten node_modules so Turbopack's file watcher doesn't follow pnpm symlinks
# into the virtual store and spawn hundreds of watcher processes on Windows
shamefully-hoist=true
